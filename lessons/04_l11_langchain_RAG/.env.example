# ==== Ollama ====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3.5:4b
# альтернативы: yandex/YandexGPT-5-Lite-8B-instruct-GGUF:latest, llama3:latest

# ==== Embeddings (HuggingFace, CPU) ====
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ==== Qdrant ====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_docs

# ==== Chunking ====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ==== Paths ====
DOCS_DIR=./docs
