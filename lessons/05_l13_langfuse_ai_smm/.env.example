# Ollama (локальный, CPU-only)
OLLAMA_BASE_URL=http://localhost:11434

# Модели по ролям (см. docs/ARCHITECTURE.md)
STRATEGIST_MODEL=qwen3.5:9b
COPYWRITER_MODEL=vikhr-llama-3.2-3b
EDITOR_MODEL=qwen2.5:1.5b
PUBLISHER_MODEL=qwen2.5:3b

MAX_REVISION_ROUNDS=3
LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT_S=300

NICHE=Сеть кофеен в Москве
SOCIAL_NETWORK=VK

OUTPUT_DIR=data/logs

# Langfuse (опционально, оставьте пустыми чтобы отключить трейсинг)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
